# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & local env ---
*.log
.env

# --- Large / regenerable data ---
# Raw SWF traces are shipped gzipped (*.swf.gz is tracked); uncompressed
# extractions and the per-trace datasets they generate are not.
*.swf
real_trace_dataset_*.csv
.opencode

# LaTeX build artifacts
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# Reference papers: copyrighted PDFs obtained via institutional subscription.
# Kept locally for writing; NOT redistributable from a public repository.
# 06_paper/00-README-reference-papers.md documents what they are and where to get them.
06_paper/*.pdf
