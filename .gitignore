# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Tooling caches ---
.ruff_cache/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
catboost_info/
